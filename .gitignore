# The JS packages' generated components are build output; Flutter's generated
# Dart (lib/src/generated) is committed — pub.dev publishes from the git tree.
packages/*/src/generated/
packages/icons/dist/
*.tsbuildinfo
.DS_Store
.env*
!.env.example
spike/**/.render/
.source/

# Playwright run output. Baselines under tests/visual/*-snapshots/ are committed.
test-results/
playwright-report/
blob-report/

# Mockup deck, kept out of the repo — it is a design artefact, not source.
Iconmind UI mockups/
.vercel

# Flutter example: runner scaffolding and local artefacts stay out of the repo;
# lib/ + pubspec.yaml are what pub.dev publishes.
**/.dart_tool/
packages/flutter/example/web/
packages/flutter/example/pubspec.lock
