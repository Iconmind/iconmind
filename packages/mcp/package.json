{
  "name": "@iconmind/mcp",
  "version": "0.3.1",
  "type": "module",
  "license": "MIT",
  "description": "MCP server for IconMind — lets an AI assistant search the real icon set instead of guessing names. Offline, bundled data, instant start.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iconmind/iconmind.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "iconmind-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0"
  },
  "devDependencies": {
    "@iconmind/icons": "workspace:*",
    "@iconmind/shared": "workspace:*",
    "tsup": "^8.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "icons",
    "svg",
    "ai",
    "llm",
    "agents",
    "mcp",
    "rag",
    "icon-set",
    "iconmind",
    "mcp-server",
    "model-context-protocol"
  ],
  "homepage": "https://iconmind.dev",
  "bugs": "https://github.com/Iconmind/iconmind/issues"
}
