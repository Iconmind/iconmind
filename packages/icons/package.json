{
  "name": "@iconmind/icons",
  "version": "0.6.0",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iconmind/iconmind.git",
    "directory": "packages/icons"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "default": "./dist/metadata.js"
    },
    "./metadata.json": "./dist/metadata.json",
    "./sprite.svg": "./dist/sprite.svg",
    "./icons/*": "./icons/*",
    "./package.json": "./package.json",
    "./iconify.json": "./dist/iconify.json"
  },
  "files": [
    "dist",
    "icons"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsx ../../scripts/generate/metadata.ts && tsx ../../scripts/generate/sprite.ts && tsx ../../scripts/generate/icons-entry.ts"
  },
  "types": "./dist/index.d.ts",
  "devDependencies": {
    "@iconmind/shared": "workspace:*",
    "tsx": "^4.20.6"
  },
  "description": "2,337 SVG icons for AI-era software — LLMs, agents, MCP, RAG. Six cells per icon: outline & duotone at three weights.",
  "keywords": [
    "icons",
    "svg",
    "ai",
    "llm",
    "agents",
    "mcp",
    "rag",
    "icon-set",
    "iconmind",
    "sprite",
    "metadata"
  ],
  "homepage": "https://iconmind.dev",
  "bugs": "https://github.com/Iconmind/iconmind/issues"
}
