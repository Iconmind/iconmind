{
  "name": "@iconmind/react-native",
  "version": "0.4.0",
  "description": "React Native components for IconMind — 2,041 tree-shakeable icons for AI-era software, rendered with react-native-svg.",
  "keywords": [
    "icons",
    "svg",
    "ai",
    "llm",
    "agents",
    "mcp",
    "rag",
    "icon-set",
    "iconmind",
    "react-native",
    "components"
  ],
  "homepage": "https://iconmind.dev",
  "bugs": "https://github.com/Iconmind/iconmind/issues",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iconmind/iconmind.git",
    "directory": "packages/react-native"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/generated/*.d.ts",
      "default": "./dist/generated/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native-svg": ">=13"
  },
  "devDependencies": {
    "react": "^19.2.0",
    "@types/react": "^19.2.2",
    "react-native-svg": "^15.11.1",
    "tsup": "^8.5.0",
    "@iconmind/icons": "workspace:*",
    "tsx": "^4.20.6"
  }
}