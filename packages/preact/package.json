{
  "name": "@iconmind/preact",
  "version": "0.6.3",
  "description": "Preact components for IconMind — 2,437 tree-shakeable icons for AI-era software (LLMs, agents, MCP, RAG).",
  "keywords": [
    "icons",
    "svg",
    "ai",
    "llm",
    "agents",
    "mcp",
    "rag",
    "icon-set",
    "iconmind",
    "preact",
    "components"
  ],
  "homepage": "https://iconmind.dev",
  "bugs": "https://github.com/Iconmind/iconmind/issues",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iconmind/iconmind.git",
    "directory": "packages/preact"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/generated/*.d.ts",
      "default": "./dist/generated/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "preact": ">=10"
  },
  "devDependencies": {
    "preact": "^10.25.4",
    "preact-render-to-string": "^6.5.13",
    "tsup": "^8.5.0",
    "@iconmind/icons": "workspace:*",
    "tsx": "^4.20.6"
  }
}